# .env.example — 실제 값을 넣지 말고, 로컬에서만 `.env`(gitignore)에 복사해 채운다.
# 이 파일은 공개 저장소에 커밋되므로 어떤 실제 키·이메일도 여기에 적지 않는다.

# ── FRED (거시) ──────────────────────────────────────────
FRED_API_KEY=your_fred_api_key_here

# ── Finnhub (뉴스·보조 시세) ─────────────────────────────
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── SEC EDGAR (필수: 이름 + 연락 이메일) ─────────────────
# 형식: <app-name>/<version> (contact: <email>)
# 실제 이메일은 Secret/로컬 .env 로만 주입한다 (6.4).
SEC_USER_AGENT=us-stock-advisor/0.1 (contact: you@example.com)

# ── 비공개 아카이브 (Actions Variable + Secret) ───────────
# PRIVATE_ARCHIVE_REPO=owner/us-stock-advisor-archive
# ARCHIVE_REPO_TOKEN=github_pat_...
# 선택: R2/S3
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
